<div class="saved-toast" data-saved-toast aria-live="polite"></div>
<script src="../scripts/saved-toast.ts"></script>

<style>
	.saved-toast {
		position: fixed;
		left: 50%;
		bottom: 1.25rem;
		transform: translate(-50%, 0.5rem);
		background: var(--color-jungle-dark);
		color: var(--color-white);
		padding: 0.55rem 1.1rem;
		border-radius: var(--radius-pill);
		font-size: 0.85rem;
		font-weight: 600;
		box-shadow: var(--shadow-card);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
		z-index: 100;
	}

	.saved-toast.is-visible {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.saved-toast.is-error {
		background: var(--color-terracotta-dark);
	}
</style>
