---
import type { Restaurant } from '../data/types';

interface Props {
	restaurants: Restaurant[];
}

const { restaurants } = Astro.props;
---

{
	restaurants.length > 0 && (
		<ul class="restaurant-list">
			{restaurants.map((r) => (
				<li>
					<span class="restaurant-name">🍴 {r.name}</span>
					{r.note && <span class="restaurant-note">{r.note}</span>}
				</li>
			))}
		</ul>
	)
}

<style>
	.restaurant-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.restaurant-list li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px dashed var(--color-border);
	}

	.restaurant-list li:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.restaurant-name {
		font-weight: 500;
	}

	.restaurant-note {
		color: var(--color-ink-soft);
		font-size: 0.85rem;
	}
</style>
