---
import { stations } from '../data/stations';

interface Props {
	activeSlug: string;
}

const { activeSlug } = Astro.props;

const VIEW_W = 400;
const VIEW_H = 260;

function toPx(x: number, y: number) {
	return { cx: (x / 100) * VIEW_W, cy: (y / 100) * VIEW_H };
}
---

<div class="bali-map card">
	<svg viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} role="img" aria-label="Illustrierte Karte unserer Bali-Route">
		<rect x="0" y="0" width={VIEW_W} height={VIEW_H} fill="var(--color-ocean-tint)" />

		<!-- Lombok (hint, muted) -->
		<ellipse cx="336" cy="92" rx="46" ry="34" fill="var(--color-sand-dark)" opacity="0.5" />
		<text x="336" y="96" text-anchor="middle" class="map-region-label" opacity="0.6">Lombok</text>

		<!-- Bali main island (stylised, not to scale) -->
		<path
			d="M90,80 C130,58 178,52 212,72 C244,90 252,112 244,140 C262,150 256,182 230,197 C208,217 168,222 138,210 C108,200 88,190 74,164 C54,138 58,108 90,80 Z"
			fill="var(--color-sand-dark)"
			stroke="var(--color-jungle)"
			stroke-width="2"
		/>
		<text x="150" y="140" text-anchor="middle" class="map-region-label">Bali</text>

		<!-- Nusa Penida -->
		<path d="M240,168 C252,160 268,162 276,174 C284,186 278,200 264,204 C250,208 236,200 234,188 C233,180 234,174 240,168 Z" fill="var(--color-sand-dark)" stroke="var(--color-jungle)" stroke-width="2" />

		<!-- Gili Trawangan -->
		<circle cx="308" cy="80" r="9" fill="var(--color-sand-dark)" stroke="var(--color-jungle)" stroke-width="2" />

		<!-- compass -->
		<g class="map-compass" transform="translate(368,26)">
			<line x1="0" y1="10" x2="0" y2="-10" stroke="var(--color-ink-soft)" stroke-width="1.5" />
			<path d="M0,-12 L4,-4 L-4,-4 Z" fill="var(--color-ink-soft)" />
			<text x="0" y="22" text-anchor="middle" class="map-compass-label">N</text>
		</g>

		{
			stations.map((station) => {
				const { cx, cy } = toPx(station.mapPosition.x, station.mapPosition.y);
				const isActive = station.slug === activeSlug;
				const scale = isActive ? 1.5 : 1;
				const pin = (
					<g
						class:list={['map-pin', `accent-${station.accent}`, { 'is-active': isActive }]}
						transform={`translate(${cx},${cy}) scale(${scale})`}
					>
						<path d="M0,14 C-6,4 -10,-2 -10,-8 A10,10 0 1 1 10,-8 C10,-2 6,4 0,14 Z" fill="var(--accent)" stroke="var(--color-white)" stroke-width="1.5" />
						<circle cx="0" cy="-8" r="4" fill="var(--color-white)" />
						<text x="0" y="30" text-anchor="middle" class="map-pin-label">
							{station.name}
						</text>
					</g>
				);
				return isActive ? (
					pin
				) : (
					<a href={`/reise/${station.slug}`} aria-label={`Zu ${station.name}`}>
						{pin}
					</a>
				);
			})
		}
	</svg>
	<p class="map-caption">Illustrierte Karte, nicht maßstabsgetreu — zur groben Orientierung.</p>
</div>

<style>
	.bali-map {
		padding: 1.5rem;
	}

	.bali-map svg {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	.map-region-label {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		fill: var(--color-ink-soft);
		opacity: 0.7;
	}

	.map-compass-label {
		font-size: 11px;
		font-weight: 700;
		fill: var(--color-ink-soft);
	}

	.map-pin {
		cursor: pointer;
		transition: transform 0.15s ease;
	}

	.map-pin:not(.is-active) {
		opacity: 0.6;
	}

	a:hover .map-pin:not(.is-active) {
		opacity: 0.9;
	}

	.map-pin-label {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 600;
		fill: var(--color-ink);
	}

	.map-pin:not(.is-active) .map-pin-label {
		font-weight: 500;
		fill: var(--color-ink-soft);
	}

	.map-caption {
		margin: 1rem 0 0;
		font-size: 0.8rem;
		color: var(--color-ink-soft);
		text-align: center;
	}
</style>
