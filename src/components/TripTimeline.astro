---
import { stations } from '../data/stations';
import StationCard from './StationCard.astro';
import { formatDateShort, nightsLabel } from '../lib/format';

interface Props {
	variant?: 'mini' | 'full';
}

const { variant = 'full' } = Astro.props;
const formatDate = formatDateShort;
---

{
	variant === 'mini' ? (
		<div class="timeline-mini">
			{stations.map((station, i) => (
				<StationCard station={station} index={i} />
			))}
		</div>
	) : (
		<div class="timeline-full">
			<div class="timeline-line" aria-hidden="true" />
			{stations.map((station, i) => (
				<a class={`timeline-node accent-${station.accent}`} href={`/reise/${station.slug}`}>
					<span class="timeline-dot">{station.icon}</span>
					<div class="timeline-node-body card card-pad">
						<span class="eyebrow">Station {i + 1}</span>
						<h3>{station.name}</h3>
						<p class="timeline-dates">
							{formatDate(station.dateRange.start)} – {formatDate(station.dateRange.end)} · {nightsLabel(station.nights)}
						</p>
						<p class="timeline-tagline">{station.tagline}</p>
						<span class="timeline-link">Details ansehen →</span>
					</div>
				</a>
			))}
		</div>
	)
}

<style>
	.timeline-mini {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.5rem;
	}

	.timeline-full {
		position: relative;
		display: flex;
		gap: 2rem;
		overflow-x: auto;
		padding: 1rem 0.5rem 2rem;
		scroll-snap-type: x proximity;
	}

	.timeline-line {
		position: absolute;
		top: 2.1rem;
		left: 1.5rem;
		right: 1.5rem;
		height: 3px;
		background: repeating-linear-gradient(
			90deg,
			var(--color-terracotta) 0,
			var(--color-terracotta) 10px,
			transparent 10px,
			transparent 18px
		);
		z-index: 0;
	}

	.timeline-node {
		position: relative;
		z-index: 1;
		flex: 0 0 16rem;
		text-decoration: none;
		color: inherit;
		scroll-snap-align: start;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.timeline-dot {
		display: grid;
		place-content: center;
		width: 3.4rem;
		height: 3.4rem;
		border-radius: 50%;
		background: var(--accent);
		font-size: 1.5rem;
		box-shadow: var(--shadow-soft);
		border: 3px solid var(--color-sand);
		margin-bottom: 1rem;
	}

	.timeline-node-body {
		width: 100%;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.timeline-node:hover .timeline-node-body {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
	}

	.timeline-dates {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent-dark);
		margin-bottom: 0.5rem;
	}

	.timeline-tagline {
		font-size: 0.9rem;
		color: var(--color-ink-soft);
	}

	.timeline-link {
		display: inline-block;
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--accent-dark);
		margin-top: 0.5rem;
	}

	@media (max-width: 40rem) {
		.timeline-full {
			flex-direction: column;
			overflow-x: visible;
		}

		.timeline-line {
			top: 1rem;
			bottom: 1rem;
			left: 1.7rem;
			right: auto;
			width: 3px;
			height: auto;
			background: repeating-linear-gradient(
				180deg,
				var(--color-terracotta) 0,
				var(--color-terracotta) 10px,
				transparent 10px,
				transparent 18px
			);
		}

		.timeline-node {
			flex-direction: row;
			align-items: flex-start;
			text-align: left;
			gap: 1rem;
		}

		.timeline-dot {
			margin-bottom: 0;
			flex: none;
		}
	}
</style>
