---
import type { PackingCategory } from '../data/types';
import ProgressBar from './ProgressBar.astro';

interface Props {
	categories: PackingCategory[];
}

const { categories } = Astro.props;
const seedJson = JSON.stringify(categories).replace(/</g, '\\u003c');
---

<packing-list-island>
	<script type="application/json" data-seed is:inline set:html={seedJson} />
	<ProgressBar />
	<div class="packing-categories">
		{
			categories.map((cat) => (
				<div class="packing-category card card-pad">
					<div class="packing-category-head">
						<span class="packing-category-icon" aria-hidden="true">
							{cat.icon}
						</span>
						<h3>{cat.label}</h3>
						<span class="packing-category-count" data-category-count={cat.id}>
							0/0
						</span>
					</div>
					<ul class="checklist" data-category={cat.id} />
					<form class="checklist-add" data-category={cat.id}>
						<input type="text" name="label" placeholder="Neuer Punkt…" autocomplete="off" />
						<button type="submit" aria-label="Hinzufügen">
							+
						</button>
					</form>
				</div>
			))
		}
	</div>
</packing-list-island>
<script src="../scripts/packing-list-island.ts"></script>

<style>
	.packing-categories {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.packing-category-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1rem;
	}

	.packing-category-icon {
		flex: none;
		font-size: 1.3rem;
		line-height: 1;
	}

	.packing-category-head h3 {
		flex: 1;
		min-width: 0;
		margin: 0;
	}

	.packing-category-count {
		flex: none;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-ink-soft);
		background: var(--color-sand);
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-pill);
	}

	.packing-category .checklist {
		gap: 0.5rem;
	}

	@media (min-width: 34rem) {
		.packing-category .checklist {
			display: block;
			columns: 2;
			column-gap: 1rem;
		}

		.packing-category .checklist-item {
			break-inside: avoid;
			margin-bottom: 0.5rem;
		}
	}
</style>
