---
import { stations } from '../data/stations';

const navItems = [
	{ href: '/', label: 'Start' },
	{ href: '/reise', label: 'Route' },
	{ href: '/budget', label: 'Budget' },
	{ href: '/packliste', label: 'Packliste' },
];
const currentPath = Astro.url.pathname;
function isActive(href: string) {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href);
}
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="/">🌺 Bali <span>2026</span></a>

		<input type="checkbox" id="nav-toggle" class="nav-toggle" />
		<label for="nav-toggle" class="nav-toggle-label" aria-label="Menü öffnen">
			<span></span><span></span><span></span>
		</label>

		<nav class="site-nav">
			{
				navItems.map((item) => (
					<a href={item.href} class={isActive(item.href) ? 'active' : ''}>
						{item.label}
					</a>
				))
			}
			<select id="nav-station-select" class="nav-station-select" aria-label="Direkt zu einer Station">
				<option value="">Station…</option>
				{
					stations.map((station) => (
						<option value={`/reise/${station.slug}`} selected={currentPath === `/reise/${station.slug}`}>
							{station.icon} {station.name}
						</option>
					))
				}
			</select>
		</nav>
	</div>
</header>

<script>
	const navStationSelect = document.getElementById('nav-station-select') as HTMLSelectElement | null;
	navStationSelect?.addEventListener('change', () => {
		if (navStationSelect.value) window.location.href = navStationSelect.value;
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--color-sand) 92%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 1rem;
	}

	.brand {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.3rem;
		text-decoration: none;
		color: var(--color-jungle-dark);
		white-space: nowrap;
	}

	.brand span {
		color: var(--color-terracotta);
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-station-select {
		font-family: inherit;
		font-weight: 500;
		font-size: 0.9rem;
		color: var(--color-ink);
		background: var(--color-white);
		border: 1px solid var(--color-border);
		padding: 0.45rem 0.8rem;
		border-radius: var(--radius-pill);
		margin-left: 0.25rem;
	}

	.site-nav a {
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		color: var(--color-ink);
		padding: 0.5rem 0.9rem;
		border-radius: var(--radius-pill);
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.site-nav a:hover {
		background: var(--color-white);
	}

	.site-nav a.active {
		background: var(--color-terracotta);
		color: var(--color-white);
	}

	.nav-toggle,
	.nav-toggle-label {
		display: none;
	}

	@media (max-width: 44rem) {
		.nav-toggle-label {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 0.3rem;
			width: 2.4rem;
			height: 2.4rem;
			cursor: pointer;
			z-index: 60;
		}

		.nav-toggle-label span {
			display: block;
			height: 2px;
			background: var(--color-ink);
			border-radius: 1px;
			transition: transform 0.2s ease, opacity 0.2s ease;
		}

		.site-nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			background: var(--color-sand);
			border-bottom: 1px solid var(--color-border);
			padding: 0.75rem 1.5rem 1.25rem;
			gap: 0.25rem;
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.25s ease;
		}

		.site-nav a {
			padding: 0.7rem 0.9rem;
		}

		.nav-station-select {
			width: 100%;
			margin: 0.4rem 0 0;
		}

		.nav-toggle:checked ~ .site-nav {
			max-height: 24rem;
		}

		.nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
			transform: translateY(0.5rem) rotate(45deg);
		}

		.nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) {
			opacity: 0;
		}

		.nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
			transform: translateY(-0.5rem) rotate(-45deg);
		}
	}
</style>
