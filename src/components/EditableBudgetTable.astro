---
import type { BudgetCategory, BudgetCategoryId } from '../data/types';
import { stations } from '../data/stations';
import { trip } from '../data/trip';

interface Props {
	categories: BudgetCategory[];
}

const { categories } = Astro.props;
const seedJson = JSON.stringify(categories).replace(/</g, '\\u003c');

const stationsSeed = stations.map((s) => ({ slug: s.slug, name: s.name, activities: s.activities }));
const stationsSeedJson = JSON.stringify(stationsSeed).replace(/</g, '\\u003c');

const targetTotal = trip.budgetPerPersonCHF * trip.travelers;

const categoryColors: Record<BudgetCategoryId, string> = {
	fluege: 'var(--color-ocean)',
	hotels: 'var(--color-jungle)',
	aktivitaeten: 'var(--color-terracotta)',
	essen: 'var(--color-warning)',
	sonstiges: 'var(--color-ink-soft)',
};
---

<budget-table-island data-budget-target={targetTotal} data-travelers={trip.travelers}>
	<script type="application/json" data-seed is:inline set:html={seedJson} />
	<script type="application/json" data-stations-seed is:inline set:html={stationsSeedJson} />

	<div class="budget-summary card card-pad">
		<div class="budget-summary-head">
			<span>Ausgegeben</span>
			<span class="budget-summary-total" data-total>CHF 0.00</span>
		</div>
		<p class="budget-summary-sub">
			von <strong>CHF {targetTotal.toLocaleString('de-CH')}</strong> Ziel (<span data-target-percent>0%</span>) ·
			<span data-target-per-person>CHF 0.00</span> pro Person
		</p>

		<div class="budget-summary-bar" title={`Ziel: ${trip.budgetPerPersonCHF.toLocaleString('de-CH')} CHF × ${trip.travelers} Personen`}>
			{
				categories.map((cat) => (
					<div class="budget-summary-segment" data-segment={cat.id} style={`background:${categoryColors[cat.id]};`} />
				))
			}
		</div>
		<p class="budget-summary-open" data-open></p>

		<div class="budget-summary-legend">
			{
				categories.map((cat) => (
					<div class="budget-legend-item">
						<span class="budget-legend-dot" style={`background:${categoryColors[cat.id]};`} />
						<span class="budget-legend-label">
							{cat.icon} {cat.label}
						</span>
						<span class="budget-legend-amount" data-legend-amount={cat.id}>
							CHF 0.00
						</span>
					</div>
				))
			}
		</div>
	</div>

	<div class="budget-categories">
		{
			categories.map((cat) => (
				<div class="budget-category card card-pad">
					<div class="budget-category-head">
						<span class="budget-category-icon" aria-hidden="true">
							{cat.icon}
						</span>
						<h3>{cat.label}</h3>
						<span class="budget-category-subtotal" data-subtotal={cat.id}>
							CHF 0.00
						</span>
					</div>
					<ul class="budget-rows" data-category={cat.id} />
					<form class="checklist-add" data-category={cat.id}>
						<input type="text" name="label" placeholder="Neuer Posten…" autocomplete="off" />
						<button type="submit" aria-label="Hinzufügen">
							+
						</button>
					</form>
				</div>
			))
		}
	</div>
</budget-table-island>
<script src="../scripts/budget-table-island.ts"></script>

<style>
	.budget-summary {
		margin-bottom: 2rem;
	}

	.budget-summary-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		font-family: var(--font-heading);
		font-weight: 600;
	}

	.budget-summary-total {
		font-size: 2rem;
		color: var(--color-terracotta-dark);
	}

	.budget-summary-sub {
		margin: 0.15rem 0 1rem;
		font-size: 0.9rem;
		color: var(--color-ink-soft);
	}

	.budget-summary-sub strong {
		color: var(--color-ink);
	}

	.budget-summary-sub .is-over-target {
		color: var(--color-terracotta-dark);
		font-weight: 600;
	}

	.budget-summary-bar {
		display: flex;
		width: 100%;
		height: 0.9rem;
		border-radius: var(--radius-pill);
		overflow: hidden;
		background: var(--color-sand-dark);
		gap: 1px;
	}

	.budget-summary-segment {
		height: 100%;
		transition: width 0.25s ease;
	}

	.budget-summary-open {
		margin: 0.6rem 0 0;
		font-size: 0.85rem;
		color: var(--color-warning);
	}

	.budget-summary-legend {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 0.5rem 1rem;
		margin-top: 1.1rem;
		padding-top: 1.1rem;
		border-top: 1px solid var(--color-border);
	}

	.budget-legend-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
	}

	.budget-legend-dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		flex: none;
	}

	.budget-legend-label {
		flex: 1;
		color: var(--color-ink-soft);
	}

	.budget-legend-amount {
		font-weight: 600;
	}

	.budget-categories {
		display: grid;
		gap: 1.5rem;
	}

	.budget-category-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1rem;
	}

	.budget-category-icon {
		flex: none;
		font-size: 1.3rem;
		line-height: 1;
	}

	.budget-category-head h3 {
		flex: 1;
		min-width: 0;
		margin: 0;
	}

	.budget-category-subtotal {
		font-weight: 600;
		color: var(--color-ink-soft);
	}

	.budget-rows {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
</style>
