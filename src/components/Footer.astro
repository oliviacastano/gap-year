---
import { trip } from '../data/trip';

function formatDate(iso: string) {
	return new Date(iso).toLocaleDateString('de-CH', { day: '2-digit', month: 'long', year: 'numeric' });
}
---

<footer class="site-footer">
	<div class="container footer-inner">
		<p class="footer-title">🌺 Bali {new Date(trip.dateRange.start).getFullYear()}</p>
		<p>
			{formatDate(trip.dateRange.start)} – {formatDate(trip.dateRange.end)} · Buchungsref. {
				trip.bookingReference
			}
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		margin-top: 4rem;
	}

	.footer-inner {
		padding-block: 2rem;
		text-align: center;
		color: var(--color-ink-soft);
		font-size: 0.9rem;
	}

	.footer-title {
		font-family: var(--font-heading);
		font-weight: 600;
		color: var(--color-jungle-dark);
		margin-bottom: 0.25rem;
	}
</style>
