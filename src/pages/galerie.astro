---
import Layout from '../layouts/Layout.astro';
import { findGalleryImages } from '../lib/images';
import { stations } from '../data/stations';
---

<Layout title="Galerie">
	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Unsere Erinnerungen</span>
				<h1>Galerie</h1>
				<p>
					Noch sind hier Platzhalter — sobald wir unterwegs sind, ersetzen wir sie durch eigene
					Fotos. Einfach Bilder als <code>&lt;station&gt;-1.jpg</code>,
					<code>&lt;station&gt;-2.jpg</code> … in <code>public/images/gallery/</code> ablegen, dann
					erscheinen sie hier automatisch.
				</p>
			</div>

			{
				stations.map((station) => {
					const photos = findGalleryImages(station.slug);
					return (
						<div class="gallery-group">
							<h2>{station.name}</h2>
							<div class="gallery-grid">
								{photos.length > 0 ? (
									photos.map((src) => (
										<div class="gallery-tile">
											<img src={src} alt={station.name} loading="lazy" />
										</div>
									))
								) : (
									<div class={`gallery-tile placeholder-tile accent-${station.accent}`}>
										<span class="placeholder-icon" aria-hidden="true">
											{station.icon}
										</span>
										<span class="placeholder-label">{station.name}</span>
										<span class="placeholder-note">Platzhalter</span>
									</div>
								)}
							</div>
						</div>
					);
				})
			}
		</div>
	</section>
</Layout>

<style>
	.gallery-group {
		margin-bottom: 2.5rem;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: 1rem;
	}

	.gallery-tile {
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		aspect-ratio: 1 / 1;
	}

	.gallery-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
